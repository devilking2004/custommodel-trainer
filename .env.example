# Copy this file to .env before running Docker Compose.

# Backend
API_ENVIRONMENT=development
API_DATABASE_URL=postgresql+psycopg://custommodel:custommodel@postgres:5432/custommodel_trainer
API_SECRET_KEY=change-me-run-openssl-rand-hex-32
API_ACCESS_TOKEN_EXPIRE_MINUTES=1440
API_CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# PostgreSQL
POSTGRES_USER=custommodel
POSTGRES_PASSWORD=custommodel
POSTGRES_DB=custommodel_trainer

# Redis
REDIS_URL=redis://redis:6379/0

# S3-compatible storage, MinIO in local development
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=custommodel-trainer
S3_REGION=us-east-1

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
