# App
APP_NAME=CustomModel Trainer API
APP_ENV=local
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security
# Generate with: openssl rand -hex 32
API_SECRET_KEY=replace-me-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Generate with: openssl rand -hex 32
API_KEY_PEPPER=replace-me-with-a-different-long-random-secret

# Database
DATABASE_URL=postgresql+psycopg://custommodel:custommodel@postgres:5432/custommodel

# Redis / RQ
REDIS_URL=redis://redis:6379/0
RQ_QUEUE_NAME=custommodel-training

# S3-compatible storage. Local Docker uses MinIO.
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_BASE_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=custommodel-trainer
S3_REGION=us-east-1
S3_USE_SSL=false

# Upload limits
MAX_UPLOAD_MB=100
MAX_ICON_MB=5

# Development helpers
RUN_MIGRATIONS=true
